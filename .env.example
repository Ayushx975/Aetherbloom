NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Get these from: Supabase Dashboard > Project Settings > API
# After adding, run the SQL in supabase/schema.sql, then migration_002.sql and migration_003.sql in Supabase SQL Editor
#
# Optional but recommended: enables trusted server-side progression
# (XP/level/purchase math in /api instead of the browser).
# NEVER expose this key to the browser (no NEXT_PUBLIC_ prefix).
# Get it from: Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
